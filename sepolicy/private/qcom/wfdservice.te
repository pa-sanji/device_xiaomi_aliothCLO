# The 32-bit wfdservice enters its own minijail and reads its seccomp policy
# from /system_ext/etc/seccomp_policy/wfdservice.policy before doing anything
# else (android::SetUpMinijail). Everything under /system_ext is labelled
# system_file, and no vendor domain is allowed to read system_file, so the
# process used to abort with "Could not read base policy file" and init
# reported init.svc.wfdservice as stopped as soon as the WFD app started it.
allow vendor_wfdservice system_file:dir { search getattr };
allow vendor_wfdservice system_file:file r_file_perms;
